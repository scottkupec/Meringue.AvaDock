  <UserControl x:Class="Meringue.AvaDock.Controls.ItemTitleBar"
               xmlns="https://github.com/avaloniaui"
               xmlns:viewModels="clr-namespace:Meringue.AvaDock.ViewModels"
               xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
               x:DataType="viewModels:DockItemViewModel"
               Background="Transparent">

  <UserControl.ContextMenu>
    <ContextMenu x:Name="PART_ContextMenu"/>
  </UserControl.ContextMenu>

    <Grid VerticalAlignment="Center">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>

      <TextBlock Grid.Column="0"
                 Text="{Binding Title}"
                 FontSize="{DynamicResource AvaDockFontSize}"
                 TextTrimming="CharacterEllipsis"
                 VerticalAlignment="Center"
                 Margin="0,0,10,0" />
      <Button Grid.Column="1"
              Classes="item-title-bar"
              Command="{Binding MinimizeCommand}"
              Margin="0,0,0,0"
              HorizontalAlignment="Center"
              VerticalAlignment="Center"
              IsEnabled="{Binding !DisableMinimize}"
              IsVisible="{Binding !DisableMinimize}">
        <!-- Minimize icon -->
        <Viewbox Width="{DynamicResource AvaDockFontSize}"
                 Height="{DynamicResource AvaDockFontSize}"
                 Stretch="Uniform"
                 HorizontalAlignment="Center"
                 VerticalAlignment="Center">
          <Path Data="M2 10 H14"
                Stroke="{DynamicResource AvaDockChromeColor}"
                StrokeThickness="1" />
        </Viewbox>
      </Button>
      <Button Grid.Column="2"
              Classes="item-title-bar"
              Command="{Binding HideCommand}"
              Margin="5,0,0,0"
              HorizontalAlignment="Center"
              VerticalAlignment="Center"
              IsEnabled="{Binding !DisableHide}"
              IsVisible="{Binding !DisableHide}">
        <!-- View (eye) icon -->
        <Viewbox Width="{DynamicResource AvaDockFontSize}"
                 Height="{DynamicResource AvaDockFontSize}"
                 Stretch="Uniform"
                 HorizontalAlignment="Center"
                 VerticalAlignment="Center">
          <Path Data="M5.47 10 C7.0 5.47 13.0 5.47 14.53 10 C13.0 14.53 7.0 14.53 5.47 10 Z M10 8 A2 2 0 1 1 10 12 A2 2 0 1 1 10 8 Z"
                Stroke="{DynamicResource AvaDockChromeColor}"
                StrokeThickness="1" />
        </Viewbox>
      </Button>

      <Button Grid.Column="3"
              Classes="item-title-bar"
              Command="{Binding CloseCommand}"
              Margin="5,0,0,0"
              HorizontalAlignment="Center"
              VerticalAlignment="Center"
              IsEnabled="{Binding !DisableClose}"
              IsVisible="{Binding !DisableClose}">
        <!-- Close icon -->
        <Viewbox Width="{DynamicResource AvaDockFontSize}"
                 Height="{DynamicResource AvaDockFontSize}"
                 Stretch="Uniform"
                 HorizontalAlignment="Center"
                 VerticalAlignment="Center">
          <Path Data="M5.47 5.47L14.53 14.53M14.53 5.47L5.47 14.53"
                Stroke="{DynamicResource AvaDockChromeColor}"
                StrokeThickness="2" />
        </Viewbox>
      </Button>
    </Grid>
</UserControl>
